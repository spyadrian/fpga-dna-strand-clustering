 	rm $(BUILD)/constants.o && make build
 
 $(BUILD)/constants.o: $(SRC)/constants.cpp
-	$(DPCPP) $(DPCPP_FLAGS) $(PARAMS) $< -c -o $@
+	$(DPCPP) $(DPCPP_FLAGS) $< -c -o $@
 
 $(BUILD)/%.o: $(SRC)/%.cpp
 	$(DPCPP) $(DPCPP_FLAGS)  $< -c -o $@
 
 
